                  "skill_call"
                ]
              }
            }
          },
          "actor": {
            "properties": {
              "actor_type": {
                "enum": [
                  "person",
                  "service",
                  "runtime_component"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "type": {
                "const": "cancel"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "channel": {
                "enum": [
                  "keyboard_binding",
                  "local_ui",
                  "remote_ui",
                  "reserved_voice_grammar",
                  "api",
                  "wms",
                  "runtime_internal"
                ]
              }
            }
          },
          "target": {
            "properties": {
              "scope": {
                "enum": [
                  "mission",
                  "task",
                  "parallel_group",
                  "skill_call"
                ]
              }
            }
          },
          "actor": {
            "properties": {
              "actor_type": {
                "enum": [
                  "person",
                  "service",
                  "runtime_component"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "type": {
                "const": "resume"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "channel": {
                "enum": [
                  "keyboard_binding",
                  "local_ui",
                  "remote_ui",
                  "reserved_voice_grammar",
                  "api",
                  "runtime_internal"
                ]
              }
            }
          },
          "target": {
            "properties": {
              "scope": {
                "enum": [
                  "mission",
                  "task",
                  "parallel_group",
                  "skill_call"
                ]
              }
            }
          },
          "actor": {
            "properties": {
              "actor_type": {
                "enum": [
                  "person",
                  "service",
                  "runtime_component"
                ]
              }
            }
          },
          "expected_state_version": {
            "type": "integer"
          },
          "expected_graph_version": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "type": {
                "const": "request_status"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "channel": {
                "enum": [
                  "keyboard_binding",
                  "local_ui",
                  "remote_ui",
                  "reserved_voice_grammar",
                  "api",
                  "wms",
                  "runtime_internal"
                ]
              }
            }
          },
          "target": {
            "properties": {
              "scope": {
                "enum": [
                  "robot",
