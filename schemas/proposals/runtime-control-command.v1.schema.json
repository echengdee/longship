                  "task",
                  "skill_call"
                ]
              }
            }
          },
          "actor": {
            "properties": {
              "actor_type": {
                "enum": [
                  "person",
                  "service",
                  "runtime_component"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "type": {
                "const": "answer_confirmation"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "channel": {
                "enum": [
                  "keyboard_binding",
                  "local_ui",
                  "remote_ui",
                  "reserved_voice_grammar",
                  "api"
                ]
              }
            }
          },
          "target": {
            "properties": {
              "scope": {
                "enum": [
                  "confirmation_challenge"
                ]
              }
            }
          },
          "actor": {
            "properties": {
              "actor_type": {
                "enum": [
