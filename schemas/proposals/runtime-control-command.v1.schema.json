                ]
              }
            }
          },
          "actor": {
            "properties": {
              "actor_type": {
                "enum": [
                  "person",
                  "service",
                  "runtime_component"
                ]
              }
            }
          },
          "expected_state_version": {
            "type": "integer"
          },
          "expected_graph_version": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
