{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:longship:schema:control-command-result:v1",
  "title": "ControlCommandResult",
  "description": "Draft immutable acknowledgement/effect record for deterministic runtime controls and protective-stop requests. Acceptance is not proof that motion ceased.",
  "x-longship-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "request_kind",
    "request_id",
    "correlation_id",
    "result_sequence",
    "observed_at",
    "monotonic_time_ns",
    "phase",
    "source",
    "verification",
    "reason_code",
    "processing_path",
    "brain_invoked",
    "state_version_before",
    "state_version_after",
    "graph_version_before",
    "graph_version_after",
    "affected_node_ids",
    "emitted_event_ids",
    "stop_timing"
  ],
  "properties": {
    "schema_version": {
      "const": "longship.control-command-result.v1"
    },
    "result_id": {
      "$ref": "#/$defs/id"
    },
    "request_kind": {
      "enum": [
        "runtime_control_command",
        "safety_stop_request"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "correlation_id": {
      "$ref": "#/$defs/id"
    },
    "result_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "monotonic_time_ns": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "enum": [
        "accepted",
        "rejected",
        "duplicate",
        "commanded",
        "effect_observed",
        "safe_state_verified",
        "timed_out",
        "failed"
      ]
    },
    "reason_code": {
      "$ref": "#/$defs/id"
    },
    "processing_path": {
      "enum": [
        "deterministic_runtime",
        "local_safety"
      ]
    },
    "brain_invoked": {
      "const": false
    },
    "state_version_before": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "state_version_after": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "graph_version_before": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "graph_version_after": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "affected_node_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "emitted_event_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "stop_timing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/stopTiming"
        }
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "verification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/verification"
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "stopTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recognized_ns",
        "safety_received_ns",
        "target_commanded_ns",
        "motion_ceased_ns",
        "safe_state_verified_ns",
        "motion_threshold_profile_id",
        "clock_domain_id",
        "clock_relation",
        "max_clock_error_ns",
        "resolved_stop_profile_id"
      ],
      "properties": {
        "recognized_ns": {
          "type": "integer",
          "minimum": 0
        },
        "safety_received_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "target_commanded_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "motion_ceased_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "safe_state_verified_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "motion_threshold_profile_id": {
          "$ref": "#/$defs/id"
        },
        "clock_domain_id": {
          "$ref": "#/$defs/id"
        },
        "clock_relation": {
          "enum": [
            "same_monotonic_domain",
            "synchronized_domains",
            "unsynchronized"
          ]
        },
        "max_clock_error_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "resolved_stop_profile_id": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "clock_relation": {
                "const": "unsynchronized"
              }
            },
            "required": [
              "clock_relation"
            ]
          },
          "then": {
            "properties": {
              "max_clock_error_ns": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "max_clock_error_ns": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "component_version",
        "instance_id",
        "authority"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/id"
        },
        "component_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "instance_id": {
          "$ref": "#/$defs/id"
        },
        "authority": {
          "enum": [
            "interaction_gateway",
            "runtime",
            "safety_kernel",
            "target_monitor"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "criterion_profile_id",
        "state_version",
        "evidence_refs"
      ],
      "properties": {
        "verifier": {
          "$ref": "#/$defs/source"
        },
        "criterion_profile_id": {
          "$ref": "#/$defs/id"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "request_kind": {
          "const": "runtime_control_command"
        },
        "phase": {
          "enum": [
            "accepted",
            "rejected",
            "duplicate",
            "commanded",
            "effect_observed",
            "timed_out",
            "failed"
          ]
        },
        "stop_timing": {
          "type": "null"
        }
      },
      "required": [
        "request_kind",
        "phase",
        "stop_timing"
      ]
    },
    {
      "properties": {
        "request_kind": {
          "const": "safety_stop_request"
        },
        "phase": {
          "enum": [
            "rejected",
            "duplicate",
            "failed"
          ]
        },
        "stop_timing": {
          "type": "null"
        }
      },
      "required": [
        "request_kind",
        "phase",
        "stop_timing"
      ]
    },
    {
      "properties": {
        "request_kind": {
          "const": "safety_stop_request"
        },
        "phase": {
          "const": "accepted"
        },
        "source": {
          "properties": {
            "authority": {
              "const": "safety_kernel"
            }
          }
        },
        "stop_timing": {
          "allOf": [
            {
              "$ref": "#/$defs/stopTiming"
            },
            {
              "properties": {
                "safety_received_ns": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      },
      "required": [
        "request_kind",
        "phase",
        "source",
        "stop_timing"
      ]
    },
    {
      "properties": {
        "request_kind": {
          "const": "safety_stop_request"
        },
        "phase": {
          "const": "commanded"
        },
        "source": {
          "properties": {
            "authority": {
              "const": "safety_kernel"
            }
          }
        },
        "stop_timing": {
          "allOf": [
            {
              "$ref": "#/$defs/stopTiming"
            },
            {
              "properties": {
                "safety_received_ns": {
                  "type": "integer"
                },
                "target_commanded_ns": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      },
      "required": [
        "request_kind",
        "phase",
        "source",
        "stop_timing"
      ]
    },
    {
      "properties": {
        "request_kind": {
          "const": "safety_stop_request"
        },
        "phase": {
          "const": "effect_observed"
        },
        "source": {
          "properties": {
            "authority": {
              "enum": [
                "safety_kernel",
                "target_monitor"
              ]
            }
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "stop_timing": {
          "allOf": [
            {
              "$ref": "#/$defs/stopTiming"
            },
            {
              "properties": {
                "safety_received_ns": {
                  "type": "integer"
                },
                "target_commanded_ns": {
                  "type": "integer"
                },
                "motion_ceased_ns": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      },
      "required": [
        "request_kind",
        "phase",
        "source",
        "verification",
        "stop_timing"
      ]
    },
    {
      "properties": {
        "request_kind": {
          "const": "safety_stop_request"
        },
        "phase": {
          "const": "safe_state_verified"
        },
        "source": {
          "properties": {
            "authority": {
              "enum": [
                "safety_kernel",
                "target_monitor"
              ]
            }
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "stop_timing": {
          "allOf": [
            {
              "$ref": "#/$defs/stopTiming"
            },
            {
              "properties": {
                "safety_received_ns": {
                  "type": "integer"
                },
                "target_commanded_ns": {
                  "type": "integer"
                },
                "motion_ceased_ns": {
                  "type": "integer"
                },
                "safe_state_verified_ns": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      },
      "required": [
        "request_kind",
        "phase",
        "source",
        "verification",
        "stop_timing"
      ]
    },
    {
      "properties": {
        "request_kind": {
          "const": "safety_stop_request"
        },
        "phase": {
          "const": "timed_out"
        },
        "source": {
          "properties": {
            "authority": {
              "enum": [
                "safety_kernel",
                "target_monitor"
              ]
            }
          }
        },
        "stop_timing": {
          "$ref": "#/$defs/stopTiming"
        }
      },
      "required": [
        "request_kind",
        "phase",
        "source",
        "stop_timing"
      ]
    }
  ]
}
