{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:longship:schema:brain-request:v1",
  "title": "BrainRequest",
  "description": "Draft provider-neutral, bounded context assembled by Runtime for one event-driven high-level decision.",
  "x-longship-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "correlation_id",
    "decision_idempotency_key",
    "trigger",
    "created_at",
    "decision_deadline_at",
    "task_state",
    "execution_snapshot",
    "relevant_world_facts",
    "previous_decision",
    "recent_events",
    "available_skills",
    "historical_episode_refs",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "longship.brain-request.v1"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_state": {
      "$ref": "#/$defs/taskState"
    },
    "execution_snapshot": {
      "$ref": "urn:longship:schema:execution-snapshot:v1",
      "description": "Authoritative snapshot; raw high-rate telemetry is not included."
    },
    "relevant_world_facts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/worldFact"
      }
    },
    "previous_decision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/previousDecision"
        }
      ]
    },
    "recent_events": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/recentEvent"
      }
    },
    "available_skills": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/skillDescriptor"
      }
    },
    "historical_episode_refs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/episodeRef"
      }
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "correlation_id": {
      "$ref": "#/$defs/id"
    },
    "decision_idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Generated by the Orchestrator and echoed by the normalized BrainDecision."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "taskState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "goal",
        "status",
        "plan_version",
        "current_step_id",
        "retry_budget_remaining",
        "replan_budget_remaining"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "status": {
          "enum": [
            "draft",
            "accepted",
            "running",
            "paused",
            "recovering",
            "completing"
          ]
        },
        "plan_version": {
          "type": "integer",
          "minimum": 0
        },
        "current_step_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "retry_budget_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "replan_budget_remaining": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "worldFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "name",
        "value",
        "state_version",
        "observed_at",
        "valid_until",
        "confidence",
        "source_ref"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "description": "Bounded JSON value selected by the Context Builder."
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_ref": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    },
    "previousDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "accepted_at",
        "action_type",
        "based_on_state_version",
        "based_on_plan_version"
      ],
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/id"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "action_type": {
          "enum": [
            "wait_for_event",
            "continue_active_skill",
            "call_skill",
            "request_cancel",
            "replan",
            "ask_operator",
            "complete",
            "safe_stop"
          ]
        },
        "based_on_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "based_on_plan_version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "occurred_at",
        "state_version",
        "summary"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "event_type": {
          "$ref": "#/$defs/id"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "skillDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "skill_version",
        "contract_ref",
        "risk_level",
        "safe_point_mode",
        "qualified_target_ids",
        "input_schema_ref",
        "output_schema_ref",
        "side_effect_class",
        "cancellable",
        "resource_ids"
      ],
      "properties": {
        "skill_id": {
          "$ref": "#/$defs/id"
        },
        "skill_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contract_ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "safe_point_mode": {
          "enum": [
            "immediate",
            "declared_boundaries",
            "non_preemptible"
          ]
        },
        "qualified_target_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "input_schema_ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "output_schema_ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "side_effect_class": {
          "enum": [
            "none",
            "reversible",
            "irreversible"
          ]
        },
        "cancellable": {
          "type": "boolean"
        },
        "resource_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "episodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "outcome",
        "summary",
        "relevance",
        "evidence_ref"
      ],
      "properties": {
        "episode_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "enum": [
            "success",
            "partial",
            "failed",
            "cancelled",
            "safe_stopped"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "relevance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ref": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_skill_ids",
        "forbidden_skill_ids",
        "safety_policy_refs",
        "operator_confirmation_required_for",
        "max_plan_patch_operations"
      ],
      "properties": {
        "authorized_skill_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "forbidden_skill_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "safety_policy_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri-reference"
          }
        },
        "operator_confirmation_required_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "max_plan_patch_operations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id",
        "kind",
        "occurred_at",
        "dedupe_key",
        "event_ids"
      ],
      "properties": {
        "trigger_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "new_goal",
            "skill_succeeded",
            "skill_failed",
            "skill_safe_point",
            "significant_world_change",
            "operator_interrupt",
            "recovery_exhausted",
            "safety_followup",
            "plan_invalid",
            "deadline_reached"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "dedupe_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
