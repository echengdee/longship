{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:longship:schema:model-session-lock:v1",
  "title": "ModelSessionLock",
  "description": "Draft immutable audit snapshot of role-scoped model-session bindings. Each binding has an independent identity, revision, deployment lock, handoff gate, and rollback target; actuator authority still comes only from Runtime leases, arbitration, and Safety.",
  "x-longship-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lock_id",
    "runtime_session_id",
    "robot_id",
    "revision",
    "created_at",
    "immutable",
    "supersedes_lock_id",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "longship.model-session-lock.v1"
    },
    "lock_id": {
      "$ref": "#/$defs/id"
    },
    "runtime_session_id": {
      "$ref": "#/$defs/id"
    },
    "robot_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "immutable": {
      "const": true
    },
    "supersedes_lock_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "brain": {
          "$ref": "#/$defs/brainBinding"
        },
        "dialogue": {
          "$ref": "#/$defs/dialogueBinding"
        },
        "asr": {
          "$ref": "#/$defs/asrBinding"
        },
        "tts": {
          "$ref": "#/$defs/ttsBinding"
        },
        "perception": {
          "$ref": "#/$defs/perceptionBinding"
        },
        "vla_policy": {
          "$ref": "#/$defs/vlaBinding"
        },
        "locomotion_policy": {
          "$ref": "#/$defs/locomotionBinding"
        },
        "whole_body_tracking": {
          "$ref": "#/$defs/wholeBodyBinding"
        },
        "world_model": {
          "$ref": "#/$defs/worldModelBinding"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "deployment_lock_sha256",
        "deployment_lock_ref",
        "rollback_binding_id",
        "supersedes_binding_id",
        "binding_digest",
        "binding_revision",
        "binding_id",
        "session_id",
        "model",
        "adapter_id",
        "adapter_version",
        "config_digest",
        "placement",
        "authority",
        "input_contracts",
        "output_contracts",
        "deadline_ms",
        "permitted_resource_scopes",
        "handoff"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/id"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "exact_revision",
            "artifact_manifest_ref",
            "artifact_manifest_sha256"
          ],
          "properties": {
            "model_id": {
              "$ref": "#/$defs/id"
            },
            "exact_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "artifact_manifest_ref": {
              "type": "string",
              "format": "uri-reference"
            },
            "artifact_manifest_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "adapter_id": {
          "$ref": "#/$defs/id"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config_digest": {
          "$ref": "#/$defs/digest"
        },
        "placement": {
          "enum": [
            "cloud",
            "edge_server",
            "robot"
          ]
        },
        "authority": {
          "enum": [
            "advisory",
            "perception",
            "speech",
            "bounded_action_proposal"
          ]
        },
        "input_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri-reference"
          }
        },
        "output_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri-reference"
          }
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1
        },
        "permitted_resource_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "composition_profile_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "handoff": {
          "$ref": "#/$defs/handoff"
        },
        "binding_id": {
          "$ref": "#/$defs/id"
        },
        "binding_revision": {
          "type": "integer",
          "minimum": 1
        },
        "binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "supersedes_binding_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "rollback_binding_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "deployment_lock_ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "deployment_lock_sha256": {
          "$ref": "#/$defs/digest"
        },
        "role": {
          "enum": [
            "brain",
            "dialogue",
            "asr",
            "tts",
            "perception",
            "vla_policy",
            "locomotion_policy",
            "whole_body_tracking",
            "world_model"
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_gate_profile_sha256",
        "handoff_gate_profile_ref",
        "safe_point",
        "warmup_probes",
        "shadow_samples",
        "drain_timeout_ms",
        "canary_duration_ms",
        "fallback"
      ],
      "properties": {
        "safe_point": {
          "enum": [
            "immediate",
            "audio_segment",
            "utterance",
            "decision",
            "frame",
            "action_chunk",
            "stable_hold",
            "stable_stand",
            "rollout"
          ]
        },
        "warmup_probes": {
          "type": "integer",
          "minimum": 0
        },
        "shadow_samples": {
          "type": "integer",
          "minimum": 0
        },
        "drain_timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "canary_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "fallback": {
          "enum": [
            "continue_previous",
            "hold",
            "stand",
            "safe_stop"
          ]
        },
        "handoff_gate_profile_ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "handoff_gate_profile_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "actionBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "authority": {
              "const": "bounded_action_proposal"
            },
            "handoff": {
              "properties": {
                "safe_point": {
                  "enum": [
                    "action_chunk",
                    "stable_hold",
                    "stable_stand"
                  ]
                },
                "warmup_probes": {
                  "minimum": 1
                },
                "shadow_samples": {
                  "minimum": 1
                },
                "canary_duration_ms": {
                  "minimum": 1
                }
              }
            },
            "permitted_resource_scopes": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "vlaBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBinding"
        },
        {
          "properties": {
            "handoff": {
              "properties": {
                "safe_point": {
                  "enum": [
                    "action_chunk",
                    "stable_hold"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "role": {
              "const": "vla_policy"
            }
          }
        }
      ]
    },
    "locomotionBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBinding"
        },
        {
          "properties": {
            "handoff": {
              "properties": {
                "safe_point": {
                  "enum": [
                    "stable_hold",
                    "stable_stand"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "role": {
              "const": "locomotion_policy"
            }
          }
        }
      ]
    },
    "wholeBodyBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/actionBinding"
        },
        {
          "properties": {
            "handoff": {
              "properties": {
                "safe_point": {
                  "const": "stable_hold"
                }
              }
            }
          }
        },
        {
          "properties": {
            "role": {
              "const": "whole_body_tracking"
            }
          }
        }
      ]
    },
    "brainBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "role": {
              "const": "brain"
            },
            "authority": {
              "const": "advisory"
            }
          }
        }
      ]
    },
    "dialogueBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "role": {
              "const": "dialogue"
            },
            "authority": {
              "const": "advisory"
            }
          }
        }
      ]
    },
    "asrBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "role": {
              "const": "asr"
            },
            "authority": {
              "const": "perception"
            }
          }
        }
      ]
    },
    "ttsBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "role": {
              "const": "tts"
            },
            "authority": {
              "const": "speech"
            }
          }
        }
      ]
    },
    "perceptionBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "role": {
              "const": "perception"
            },
            "authority": {
              "const": "perception"
            }
          }
        }
      ]
    },
    "worldModelBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "role": {
              "const": "world_model"
            },
            "authority": {
              "const": "advisory"
            }
          }
        }
      ]
    }
  }
}
