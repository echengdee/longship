{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:longship:schema:operator-intent:v1",
  "title": "OperatorIntent",
  "description": "Draft proposal for normalized task-level intent. It never carries actuator commands or emergency-stop authority.",
  "x-longship-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "issued_at",
    "expires_at",
    "source",
    "actor",
    "priority",
    "intent",
    "correlation"
  ],
  "properties": {
    "schema_version": {
      "const": "longship.operator-intent.v1"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "priority": {
      "enum": [
        "normal",
        "high"
      ]
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "intent": {
      "oneOf": [
        {
          "$ref": "#/$defs/submitTask"
        },
        {
          "$ref": "#/$defs/controlTask"
        },
        {
          "$ref": "#/$defs/requestStatus"
        },
        {
          "$ref": "#/$defs/confirmation"
        }
      ]
    },
    "correlation": {
      "$ref": "#/$defs/correlation"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "endpoint_id"
      ],
      "properties": {
        "channel": {
          "enum": [
            "voice",
            "keyboard",
            "ui",
            "api",
            "wms"
          ]
        },
        "endpoint_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "raw_input_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Optional governed reference to source text or audio; raw private input is not embedded."
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type",
        "authorization_scopes"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor_type": {
          "enum": [
            "person",
            "service"
          ]
        },
        "authorization_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "robot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "based_on_state_version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parent_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "submitTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "goal",
        "confirmation_policy"
      ],
      "properties": {
        "kind": {
          "const": "submit_task"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "parameters": {
          "type": "object",
          "description": "Untrusted mission-specific parameters validated by the Context Compiler."
        },
        "confirmation_policy": {
          "enum": [
            "when_ambiguous",
            "always"
          ]
        }
      }
    },
    "controlTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "action",
        "task_id"
      ],
      "properties": {
        "kind": {
          "const": "control_task"
        },
        "action": {
          "enum": [
            "pause",
            "resume",
            "cancel"
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "requestStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope"
      ],
      "properties": {
        "kind": {
          "const": "request_status"
        },
        "scope": {
          "enum": [
            "robot",
            "mission",
            "task"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "challenge_id",
        "accepted"
      ],
      "properties": {
        "kind": {
          "const": "confirmation"
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "accepted": {
          "type": "boolean"
        }
      }
    }
  }
}
